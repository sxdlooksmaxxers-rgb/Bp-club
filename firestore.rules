rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /members/{memberId} {
      allow read: if true;

      // A new member profile is tied to the authenticated Firebase UID.
      allow create: if request.auth != null
                    && request.auth.uid == memberId
                    && request.resource.data.keys().hasAll(['uid','name','grade','faculty','banned'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.banned == false
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 100;

      // Existing admin behavior retained from the original site.
      allow update, delete: if request.auth != null;
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Each authenticated voter gets exactly one ballot document per day.
    // The client may add up to 3 distinct candidates, but cannot vote for itself.
    match /votes/{weekId}/days/{dayId}/voters/{voterId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == voterId
                    && request.resource.data.voterId == request.auth.uid
                    && request.resource.data.weekId == weekId
                    && request.resource.data.dayId == dayId
                    && request.resource.data.candidateIds is list
                    && request.resource.data.candidateIds.size() >= 1
                    && request.resource.data.candidateIds.size() <= 3
                    && !(request.auth.uid in request.resource.data.candidateIds)
                    && (
                      request.resource.data.candidateIds.size() == 1
                      || request.resource.data.candidateIds[0] != request.resource.data.candidateIds[1]
                    )
                    && (
                      request.resource.data.candidateIds.size() < 3
                      || (
                        request.resource.data.candidateIds[0] != request.resource.data.candidateIds[2]
                        && request.resource.data.candidateIds[1] != request.resource.data.candidateIds[2]
                      )
                    );

      // Ballots are immutable after creation; this prevents changing votes later.
      allow update, delete: if false;
    }
  }
}
